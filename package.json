{
  "name": "pg-backgammon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "start": "vite preview --open --port 4330 --strictPort",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "icons": "node scripts/generateIcons.mjs",
    "mine:puzzles": "node scripts/mine.mjs && biome check --write src/puzzles/curatedSet.ts",
    "validate:puzzles": "node scripts/validate.mjs",
    "e2e": "playwright test --project=smoke",
    "e2e:audit": "playwright test --project=audit",
    "e2e:pwa": "playwright test --project=pwa",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "jsdom": "^26.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.152.0"
  }
}
